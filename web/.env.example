# Where the Next.js server-side fetches the API from.
# - Local dev:        http://localhost:4000
# - docker-compose:   http://server:4000
# - ECS (same VPC):   http://internal-alb-or-service-discovery:4000
#                     OR set this to the same ALB DNS the public frontend uses,
#                     since path-based routing already targets the backend on /api/*
API_URL=http://localhost:4000
